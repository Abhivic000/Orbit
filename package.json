{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write app components lib scripts shaders types \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check app components lib scripts shaders types \"*.{ts,mjs,json}\"",
    "optimize:model": "node scripts/optimize-model.mjs",
    "render:stills": "node scripts/render-stills.mjs",
    "prepare:hdri": "node scripts/prepare-hdri.mjs assets-src/hdri/studio_small_09_1k.hdr public/hdri",
    "measure": "node scripts/measure.mjs",
    "gen:model": "gltfjsx public/models/halo-one.glb --types --output components/canvas/Headphones.generated.tsx"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.1",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "gltfjsx": "^6.5.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "r3f-perf": "^7.2.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.9.0"
  }
}
